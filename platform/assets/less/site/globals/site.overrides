/*******************************
  Open Vis record badge panel
 *******************************/

#ovf-embed-badge .ovf-badge-preview {
  display: block;
  margin: 0.85rem 0 0.5rem;
  max-width: 100%;
  overflow: hidden;
}

#ovf-embed-badge .ovf-badge-preview img {
  display: block;
  height: auto;
  max-width: 100%;
}

#ovf-embed-badge .ovf-badge-embed-options {
  border-top: 1px solid rgba(34, 36, 38, 0.12);
  margin-top: 0.85rem;
  padding-top: 0.75rem;
}

#ovf-embed-badge .ovf-badge-embed-options summary {
  color: @brandColor;
  cursor: pointer;
  font-weight: 600;
}

#ovf-embed-badge .ovf-badge-embed-options label {
  display: block;
  font-size: 0.85rem;
  font-weight: 600;
  margin: 0.9rem 0 0.35rem;
}

#ovf-embed-badge .ovf-badge-copy-row {
  align-items: flex-start;
  display: flex;
  gap: 0.45rem;
}

#ovf-embed-badge .ovf-badge-copy-row textarea {
  background: #f7f7fb;
  border: 1px solid rgba(34, 36, 38, 0.18);
  border-radius: @defaultBorderRadius;
  box-sizing: border-box;
  color: #27225f;
  flex: 1 1 auto;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  font-size: 0.72rem;
  line-height: 1.4;
  min-width: 0;
  padding: 0.55rem;
  resize: vertical;
}

#ovf-embed-badge .ovf-badge-copy-row .button {
  flex: 0 0 auto;
  margin: 0;
}

#ovf-embed-badge .ovf-badge-copy-status {
  color: #2f855a;
  font-size: 0.8rem;
  min-height: 1.2em;
  margin: 0.45rem 0 0;
}

/**********************************
  Visualization disclosure summary
 **********************************/

#ovf-disclosure-summary {
  border-color: fade(@brandColor, 24%);
  border-radius: @defaultBorderRadius;
  box-shadow: 0 8px 28px rgba(39, 34, 95, 0.07);
}

.ovf-disclosure-heading {
  align-items: flex-start;
  display: flex;
  gap: 1rem;
  justify-content: space-between;
}

.ovf-disclosure-eyebrow {
  color: @brandColor;
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.09em;
  margin: 0 0 0.25rem;
}

.ovf-disclosure-score.ui.label {
  background: fade(@brandColor, 10%);
  color: @brandColor;
  margin: 0;
  white-space: nowrap;
}

.ovf-disclosure-grid {
  display: grid;
  gap: 0.65rem;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  list-style: none;
  margin: 1.25rem 0 0;
  padding: 0;
}

.ovf-disclosure-item {
  align-items: flex-start;
  background: #f8f8fc;
  border: 1px solid rgba(34, 36, 38, 0.08);
  border-radius: @defaultBorderRadius;
  display: flex;
  gap: 0.55rem;
  min-width: 0;
  padding: 0.7rem 0.75rem;
}

.ovf-disclosure-item .icon {
  margin: 0.1rem 0 0;
}

.ovf-disclosure-item.is-complete .icon {
  color: #2f855a;
}

.ovf-disclosure-item.is-missing .icon,
.ovf-disclosure-item.is-missing small {
  color: #767676;
}

.ovf-disclosure-item strong,
.ovf-disclosure-item small {
  display: block;
}

.ovf-disclosure-item small {
  margin-top: 0.15rem;
}

.ovf-version-note {
  border-left: 3px solid @brandColor;
  margin-top: 1.25rem;
  padding: 0.15rem 0 0.15rem 0.9rem;
}

@media only screen and (max-width: 767px) {
  .ovf-disclosure-heading {
    align-items: stretch;
    flex-direction: column;
  }

  .ovf-disclosure-score.ui.label {
    align-self: flex-start;
  }

  .ovf-disclosure-grid {
    grid-template-columns: 1fr;
  }
}
