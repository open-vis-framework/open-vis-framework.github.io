# Outgoing mail for account confirmation / password reset.
#
# Copy to `mail.env` on the server and fill in real values; that file is
# gitignored and untracked, so the deploy's `git reset --hard` leaves it
# alone. Without it, InvenioRDM's default MAIL_SUPPRESS_SEND=True stands
# and no mail is sent (which is what you want in local dev).
#
# Read by every app container (web-ui, web-api, worker, scheduler) via
# docker-services.yml's `app` service. Account mail is sent synchronously
# from web-ui today (ACCOUNTS_USE_CELERY resolves to False), but covering
# every container keeps this correct if that is ever turned on.
#
# Gmail needs an App Password (Google Account > Security > App passwords,
# requires 2FA) - a normal account password will not authenticate. Gmail
# also rejects any sender that isn't the authenticated account or one of
# its verified aliases, hence the explicit sender settings below.

INVENIO_MAIL_SUPPRESS_SEND=False
INVENIO_MAIL_SERVER=smtp.gmail.com
INVENIO_MAIL_PORT=587
INVENIO_MAIL_USE_TLS=True
INVENIO_MAIL_USERNAME=you@gmail.com
INVENIO_MAIL_PASSWORD=your-16-char-app-password
INVENIO_MAIL_DEFAULT_SENDER=you@gmail.com
INVENIO_SECURITY_EMAIL_SENDER=you@gmail.com
INVENIO_SUPPORT_EMAIL=you@gmail.com
