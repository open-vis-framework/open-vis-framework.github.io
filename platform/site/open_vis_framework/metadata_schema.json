{
  "version": "0.1",
  "sections": [
    {
      "id": "overview",
      "label": "Overview & Lifecycle",
      "description": "Version history and changes to this visualization."
    },
    {
      "id": "authorship",
      "label": "Authorship & Responsibility",
      "description": "Add a public contact for questions about this visualization."
    },
    {
      "id": "purpose",
      "label": "Purpose & Context",
      "description": "Explain the purpose and help readers interpret the visualization."
    },
    {
      "id": "data",
      "label": "Data Provenance",
      "description": "Document the origin, availability and context of the underlying data."
    },
    {
      "id": "analysis",
      "label": "Analysis & Transformation",
      "description": "Describe how source data became the values shown."
    },
    {
      "id": "design",
      "label": "Visual Encoding & Design",
      "description": "Explain visual mappings and design choices."
    },
    {
      "id": "uncertainty",
      "label": "Uncertainty & Limitations",
      "description": "State uncertainty, assumptions and limits on interpretation."
    },
    {
      "id": "quality",
      "label": "Quality Assurance",
      "description": "Describe checks actually performed; this is not a certification."
    },
    {
      "id": "production",
      "label": "Production Provenance",
      "description": "Record AI involvement when applicable and any other production tooling."
    },
    {
      "id": "distribution",
      "label": "Use & Distribution",
      "description": "Document where the visualization is hosted, embedded or reused. File uploads remain in the native upload area."
    },
    {
      "id": "rights",
      "label": "Rights & Access",
      "description": "Explain any additional conditions for reusing this visualization."
    }
  ],
  "fields": [
