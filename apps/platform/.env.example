# Copy to apps/platform/.env (git-ignored) and fill in real values.
# Never commit real secrets — see docs/ops/access.md.

# --- Database ---
# Inside docker-compose, the app reaches Postgres via the service name
# "postgres", not localhost.
DATABASE_URL=postgres://platform:changeme@postgres:5432/platform
POSTGRES_USER=platform
POSTGRES_PASSWORD=changeme
POSTGRES_DB=platform

# --- Auth.js ---
# Generate with: openssl rand -base64 33
AUTH_SECRET=
# Required when running behind a reverse proxy (Traefik in prod) that
# terminates TLS in front of the app.
AUTH_TRUST_HOST=true

AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

AUTH_ORCID_ID=
AUTH_ORCID_SECRET=
# https://sandbox.orcid.org for development, https://orcid.org in prod —
# each has its own separate app registration/credentials.
AUTH_ORCID_ISSUER=https://sandbox.orcid.org

# --- Uploads ---
UPLOADS_DIR=/app/apps/platform/uploads
STORAGE_DRIVER=disk
